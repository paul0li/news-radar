# The app calls Claude Code (`claude -p`) using this machine's login.
# On a server without an interactive login, run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional
PORT=3000
# 127.0.0.1 behind a reverse proxy or `tailscale serve`
HOST=0.0.0.0
MODEL=opus
EFFORT=low
CLAUDE_BIN=claude
# When set, the app asks for a password (Basic Auth; any username works)
APP_PASSWORD=
# Folder where saved pautas (history) are stored, one JSON file each. Default: ./data next to server.js.
# On a server that runs `git reset --hard` on deploy, point this outside the repo.
DATA_DIR=
