# La app llama a Claude Code (`claude -p`) con la sesión de esta máquina.
# En un servidor sin login interactivo: corre `claude setup-token` y pega el token aquí.
CLAUDE_CODE_OAUTH_TOKEN=
# Opcionales
PORT=3000
# 127.0.0.1 detrás de nginx, o la IP de Tailscale para exponerla solo en la tailnet
HOST=0.0.0.0
MODEL=opus
EFFORT=low
CLAUDE_BIN=claude
# Si se define, la app pide usuario/clave (Basic Auth; el usuario puede ser cualquiera)
APP_PASSWORD=
